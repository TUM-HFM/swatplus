{
    "version": 3,
    "configurePresets": [
        {
            "name": "ifort_debug",
            "displayName": "ifort debug version",
            "description": "Preset to builds ifort debug executable for swatplus",
            "binaryDir": "build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "build/debug",
                "CMAKE_Fortran_COMPILER": "ifort"
            }
        },
        {
            "name": "ifx_debug",
            "displayName": "ifx debug version",
            "description": "Preset to builds a ifx debug executable for swatplus",
            "binaryDir": "build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "build/debug",
                "CMAKE_Fortran_COMPILER": "ifx"
            }
        },
        {
            "name": "gfortran_debug",
            "displayName": "gfortran debug version",
            "description": "Builds a gfortran debug executable for swatplus",
            "binaryDir": "build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "build/debug",
                "CMAKE_Fortran_COMPILER": "gfortran"
            }
        },

        {
    "name": "ifx_release_linux",
    "displayName": "ifx release version",
    "description": "Builds a ifx release executable for swatplus for linux",
    "binaryDir": "${sourceDir}/../swatplus-build-linux-ifx-release",
    "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
    },
    "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../swatplus-build-linux-ifx-release",
        "CMAKE_Fortran_COMPILER": "ifx"
    }
},
{
    "name": "gfortran_release_linux",
    "displayName": "gfortran release version",
    "description": "Builds a gfortran release executable for swatplus for linux",
    "binaryDir": "${sourceDir}/../swatplus-build-linux-gfortran-release",
    "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
    },
    "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../swatplus-build-linux-gfortran-release",
        "CMAKE_Fortran_COMPILER": "gfortran"
    }
},
{
    "name": "ifx_debug_linux",
    "displayName": "ifx debug version (Linux, external build dir)",
    "description": "Builds an ifx debug executable for Linux outside the source tree",
    "binaryDir": "${sourceDir}/../swatplus-build-linux-ifx-debug",
    "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
    },
    "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../swatplus-build-linux-ifx-debug",
        "CMAKE_Fortran_COMPILER": "ifx"
    }
},
{
    "name": "gfortran_debug_linux",
    "displayName": "gfortran debug version (Linux, external build dir)",
    "description": "Builds a gfortran debug executable for Linux outside the source tree",
    "binaryDir": "${sourceDir}/../swatplus-build-linux-gfortran-debug",
    "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
    },
    "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/../swatplus-build-linux-gfortran-debug",
        "CMAKE_Fortran_COMPILER": "gfortran"
    }
}
    ]
}

